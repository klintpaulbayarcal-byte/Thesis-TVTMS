NODE_ENV=production
TZ=Asia/Manila
TRUST_PROXY=1

# Use the Supabase transaction-pooler connection string (port 6543) for REMOVED_HOST.
# Paste the real secret only into REMOVED_HOST Environment Variables.
DB_CLIENT=postgres
DATABASE_URL=
# Or use the POSTGRES_URL automatically injected by a REMOVED_HOST integration.
POSTGRES_URL=
DB_POOL_SIZE=3
DB_SSL=1

JWT_SECRET=
JWT_EXPIRES_IN=8h

ALLOWED_ORIGINS=https://thesis-tvtms.REMOVED_HOST.app
APP_PUBLIC_URL=https://thesis-tvtms.REMOVED_HOST.app

# Resend SMTP example. Gmail also works with smtp.gmail.com and an App Password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_TLS_REJECT_UNAUTHORIZED=1
SMTP_USER=resend
SMTP_PASS=
# REMOVED_HOST Marketplace can inject this instead of SMTP_HOST/USER/PASS.
RESEND_API_KEY=
SMTP_FROM="Calape Traffic Enforcement <no-reply@your-verified-domain.example>"
CONTACT_TO_EMAIL=
