NODE_ENV=production
TZ=Asia/Manila
PORT=3000
TRUST_PROXY=1

# Use Hostinger's Supabase Database Connect Wizard, or paste the Supabase
# transaction-pooler URL into the Hostinger environment-variable dashboard.
# Production database: Supabase PostgreSQL.
# Keep the real connection string only in Hostinger Environment Variables.
DB_CLIENT=postgres
DATABASE_URL=
POSTGRES_URL=
DB_POOL_SIZE=3
DB_SSL=1

# Generate a unique secret with at least 32 characters. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# School production frontend.
ALLOWED_ORIGINS=https://trafficviolation.dcsbisu.com
APP_PUBLIC_URL=https://trafficviolation.dcsbisu.com

# Gmail SMTP example. Use an App Password, never the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_TLS_REJECT_UNAUTHORIZED=1
SMTP_USER=
SMTP_PASS=
# Optional Resend alternative; used as the SMTP password when set.
RESEND_API_KEY=
SMTP_FROM="Calape Traffic Enforcement <no-reply@example.gov.ph>"
CONTACT_TO_EMAIL=
