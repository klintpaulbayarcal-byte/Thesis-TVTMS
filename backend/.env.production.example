NODE_ENV=production
TZ=Asia/Manila
TRUST_PROXY=1

# Use Hostinger's Supabase Database Connect Wizard, or paste the Supabase
# transaction-pooler URL into the Hostinger environment-variable dashboard.
DB_CLIENT=postgres
DATABASE_URL=
DB_POOL_SIZE=3
DB_SSL=1

JWT_SECRET=
JWT_EXPIRES_IN=8h

ALLOWED_ORIGINS=https://your-domain.example
APP_PUBLIC_URL=https://your-domain.example

# Resend SMTP example. Gmail also works with smtp.gmail.com and an App Password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_TLS_REJECT_UNAUTHORIZED=1
SMTP_USER=resend
SMTP_PASS=
# Optional Resend alternative; used as the SMTP password when set.
RESEND_API_KEY=
SMTP_FROM="Calape Traffic Enforcement <no-reply@your-verified-domain.example>"
CONTACT_TO_EMAIL=
