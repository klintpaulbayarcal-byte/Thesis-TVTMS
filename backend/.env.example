NODE_ENV=development
TZ=Asia/Manila
PORT=5000
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=violation_system
DB_POOL_SIZE=10
DB_TIMEZONE=+08:00

# Production/Supabase alternative. When DATABASE_URL is present, it is used
# instead of the DB_HOST/DB_USER settings above. Keep this value server-side.
DB_CLIENT=mysql
DATABASE_URL=
# Vercel's Supabase integration may provide POSTGRES_URL instead.
POSTGRES_URL=
DB_SSL=1

# Generate a unique 32+ character secret. Never commit the real value.
JWT_SECRET=change-this-to-a-long-random-secret-before-running
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
APP_PUBLIC_URL=http://localhost/your-project-folder/frontend

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_TLS_REJECT_UNAUTHORIZED=1
SMTP_USER=
SMTP_PASS=
# Optional Resend Marketplace alternative; used as the SMTP password when set.
RESEND_API_KEY=
SMTP_FROM="Calape Traffic Enforcement <no-reply@example.gov.ph>"
CONTACT_TO_EMAIL=

INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=
# Used only by npm run create-admin. It is cleared after a successful create or update.
INITIAL_ADMIN_PASSWORD=
