NODE_ENV=development
TZ=Asia/Manila
PORT=5000
TRUST_PROXY=0
# Supabase HTTPS API. The secret key stays on the Express server.
# Copy this file to backend/.env for local development.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Optional legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# Generate a unique 32+ character secret. Never commit the real value.
JWT_SECRET=change-this-to-a-long-random-secret-before-running
JWT_EXPIRES_IN=8h

# Same-origin deployment normally needs only the public Hostinger origin.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
APP_PUBLIC_URL=http://localhost:5000

# Resend SMTP. Create an API key and verify the sender domain before use.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_TLS_REJECT_UNAUTHORIZED=1
SMTP_USER=resend
SMTP_PASS=
RESEND_API_KEY=
SMTP_FROM="Calape Traffic Enforcement <no-reply@your-verified-domain.example>"
CONTACT_TO_EMAIL=

INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=
# Used only by npm run create-admin. It is cleared after a successful create or update.
INITIAL_ADMIN_PASSWORD=
